{
  "manifest_version": 3,
  "name": "Class Registration",
  "version": "1.0",
  "description": "An extension to register classes using FID and IndependentClassID.",
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "webRequest",
    "activeTab"
  ],
  "host_permissions": [
    "https://sv.haui.edu.vn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },

  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
